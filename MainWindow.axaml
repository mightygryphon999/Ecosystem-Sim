<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EcosystemSim"
        mc:Ignorable="d" d:DesignWidth="1600" d:DesignHeight="920"
        x:Class="EcosystemSim.MainWindow"
        Title="EcosystemSim Dashboard"
        MinWidth="1200"
        MinHeight="760">
    <Grid Margin="12" ColumnDefinitions="300,*,360" RowDefinitions="Auto,*,260">
        <Border Grid.ColumnSpan="3" Background="{DynamicResource SystemControlBackgroundAccentBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,10">
            <TextBlock Text="Ecosystem Simulation Dashboard" FontSize="20" FontWeight="SemiBold" Foreground="White" />
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" CornerRadius="8" Padding="12" Margin="0,0,10,10">
            <StackPanel Spacing="8">
                <TextBlock Text="Simulation Controls" FontSize="16" FontWeight="SemiBold" />
                <Button x:Name="StartPauseButton" Content="Start Simulation" Height="34" />
                <Button x:Name="ResetButton" Content="Reset" Height="30" />

                <TextBlock Text="Simulation Steps" Margin="0,8,0,0" />
                <TextBox x:Name="StepLimitBox" Watermark="Max steps" />

                <TextBlock Text="Initial Prey" />
                <TextBox x:Name="InitialPreyBox" />

                <TextBlock Text="Initial Predators" />
                <TextBox x:Name="InitialPredatorBox" />

                <TextBlock Text="Initial Food" />
                <TextBox x:Name="InitialFoodBox" />

                <TextBlock Text="Tick Delay (ms)" Margin="0,8,0,0" />
                <TextBox x:Name="TickDelayBox" />

                <TextBlock Text="UI Refresh (ms)" />
                <TextBox x:Name="RenderDelayBox" />

                <Button x:Name="ApplySettingsButton" Content="Apply Settings" Height="30" />
                <TextBlock x:Name="ValidationText" Foreground="IndianRed" TextWrapping="Wrap" />
                <TextBlock Text="Keyboard: Space = pause/resume" Foreground="Gray" FontSize="12" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Background="White" CornerRadius="8" Margin="0,0,10,10">
            <local:EcosystemView x:Name="EcosystemCanvas"/>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <StackPanel Spacing="8">
                <TextBlock Text="Live Stats" FontSize="16" FontWeight="SemiBold" />
                <TextBlock x:Name="StatusText" Text="Status: Not Started" />
                <TextBlock x:Name="StepText" Text="Step: 0 / 0" />
                <TextBlock x:Name="SpeciesText" Text="Species: 0" />
                <TextBlock x:Name="FoodText" Text="Food: 0" />
                <TextBlock x:Name="WaterText" Text="Water Tiles: 0" />
                <ProgressBar x:Name="SimulationProgressBar" Minimum="0" Maximum="1" Value="0" Height="12" />

                <TextBlock Text="Graph" Margin="0,8,0,0" />
                <ComboBox x:Name="GraphSelector" SelectedIndex="0">
                    <ComboBoxItem Content="Population" />
                    <ComboBoxItem Content="Female vs Male" />
                    <ComboBoxItem Content="Sprouted vs Unsprouted" />
                    <ComboBoxItem Content="Traits" />
                    <ComboBoxItem Content="None" />
                </ComboBox>

                <TextBlock Text="Legend" Margin="0,8,0,0" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="14" Height="14" Background="Black"/><TextBlock Text="Prey"/></StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="14" Height="14" Background="Red"/><TextBlock Text="Predator"/></StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="14" Height="14" Background="Green"/><TextBlock Text="Sprouted food"/></StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="14" Height="14" Background="SaddleBrown"/><TextBlock Text="Unsprouted food"/></StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="14" Height="14" Background="DodgerBlue"/><TextBlock Text="Water"/></StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Background="White" CornerRadius="8" Padding="10">
            <Canvas x:Name="GraphCanvas" Background="#FAFAFA" />
        </Border>
    </Grid>
</Window>
